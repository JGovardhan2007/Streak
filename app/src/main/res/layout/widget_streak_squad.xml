<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_squad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#16181F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_squad_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STREAK • HABIT CIRCLE"
            android:textColor="#13EC5B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_squad_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14 Active Days"
            android:textColor="#FF6B00"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_squad_habit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Morning Gym &amp; Hydrate"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_squad_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Marcus, Elena &amp; Alex checked in"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/widget_squad_btn_nudge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="⚡ Nudge"
            android:textColor="#FF6B00"
            android:backgroundTint="#33FF6B00"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_squad_btn_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-in ✓"
            android:textColor="#000000"
            android:backgroundTint="#13EC5B"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
