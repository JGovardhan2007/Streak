<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#16181F">

    <TextView
        android:id="@+id/widget_stats_flame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 14"
        android:textColor="#FF6B00"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_stats_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="75% Daily Goals Met"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_stats_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 / 4 Habits Completed Today"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_stats_btn_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open ⚡"
        android:textColor="#000000"
        android:backgroundTint="#13EC5B"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
